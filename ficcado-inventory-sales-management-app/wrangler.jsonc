{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ficcado-inventory-sales-management-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "BOOTSTRAP_SHEET_NAME": "SuperAdmin-Ficcado-CRM-Config",
    "BOOTSTRAP_SPREADSHEET_ID": "1yapMfUcPUCTkKVdo2n1CBRmfkiL8Qz04t7KGYM8orf4",
    "NEXT_PUBLIC_APP_URL": "https://ficcado-inventory-sales-management-app.arjunpslxi.workers.dev"
  }
}
